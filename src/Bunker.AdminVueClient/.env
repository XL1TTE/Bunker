# Base URL of the Node.js gateway that fronts all backend microservices.
# The admin panel calls ContentService through it at /content/*.
VITE_API_BASE_URL=http://localhost:5174

# Keycloak configuration.
#
# The base URL is only used for standalone `npm run dev` (without Aspire). When the
# admin panel is launched by the Aspire AppHost, vite.config.ts overrides it from the
# injected AUTH_HTTPS/AUTH_HTTP env var (Keycloak runs on a random Aspire proxy port).
#
# The client must be a PUBLIC client with PKCE enabled — keycloak-js (browser) cannot
# send a client secret, so do NOT use a confidential client here.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=bunker
VITE_KEYCLOAK_CLIENT_ID=bunker.admin.client

# Real Keycloak auth flow.
VITE_SKIP_AUTH=false